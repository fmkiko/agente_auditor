{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem"
            ],
            "enabled": true
        },
        "sequential-thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "enabled": true,
            "timeout": 30000
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "memory": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "enabled": true
        }
    },
    "skills": {
        "paths": [
            ".opencode/skills"
        ]
    },
    "agent": {
        "agente-descubridor": {
            "mode": "subagent",
            "description": "Descubre la arquitectura, stack y dependencias del proyecto auditado.",
            "file": ".opencode/agents/agente-descubridor.md"
        },
        "agente-revision": {
            "mode": "subagent",
            "description": "Analiza calidad, mantenibilidad y deuda técnica del proyecto.",
            "file": ".opencode/agents/agente-revision.md"
        },
        "agente-seguridad": {
            "mode": "subagent",
            "description": "Audita vulnerabilidades y riesgos de seguridad del proyecto.",
            "file": ".opencode/agents/agente-seguridad.md"
        },
        "agente-reporte": {
            "mode": "subagent",
            "description": "Consolida resultados y genera entregables ejecutivos y técnicos.",
            "file": ".opencode/agents/agente-reporte.md"
        }
    }
}
